# ============================================
# MAISON AZURE - ENVIRONMENT VARIABLES
# Copy this to .env.local for local dev
# Set these in Vercel dashboard for production
# ============================================

# Neon Postgres connection string
# Get from: https://neon.tech (free tier, 1 click setup)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Paystack secret key
# Get from: https://dashboard.paystack.com/#/settings/developers
# Use TEST key for testing (sk_test_...), LIVE key when ready (sk_live_...)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT secret for admin sessions (generate any random 32+ char string)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=replace-this-with-a-long-random-string-please

# Optional: Public Paystack key (only used if you want to add inline payment in future)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
